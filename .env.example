# Django Secret Key (generate a strong random key for production)
SECRET_KEY=django-insecure-deepfake-detection-secret-key-change-in-production

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated or * for development)
ALLOWED_HOSTS=*

# Media and Upload Limits (in bytes)
MAX_UPLOAD_SIZE=10485760             # 10MB default for images
MAX_VIDEO_UPLOAD_SIZE=104857600      # 100MB default for videos

# Model Paths
MODEL_PATH=models/deepfake_detector.h5
BEST_MODEL_PATH=models/best_model.h5

# Multi-Signal & Provenance Configuration
PROVENANCE_CHECK_ENABLED=True
LOG_LEVEL=INFO
